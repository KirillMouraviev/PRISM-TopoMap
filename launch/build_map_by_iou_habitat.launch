<launch>
  <arg name="scene_name" default="2n8kARJN3HM"/>
  <arg name="path_to_gt_map" default="/data/GT/$(arg scene_name)"/>
  <arg name="path_to_save_graph" default="/data/maps/prism_topomap/$(arg scene_name)"/>
  <arg name="path_to_save_logs" default="/data/logs/prism_topomap_logs"/>
  <arg name="config_file" default="habitat_mp3d_noised_odom.yaml"/>

  <node pkg="prism_topomap" type="prism_topomap_node.py" name="prism_topomap_node" output="screen">
    <param name="path_to_gt_map" value="$(arg path_to_gt_map)"/>
    <param name="path_to_save_graph" value="$(arg path_to_save_graph)"/>
    <param name="config_file" value="$(arg config_file)"/>
  </node>

  <node pkg="prism_topomap" type="tf_manager.py" name="odom_from_tf">
    <param name="publish_odom_from_tf" value="true"/>
    <param name="source_frame" value="map_toposlam"/>
    <param name="target_frame" value="base_link"/>
  </node>

  <node pkg="tf" type="static_transform_publisher" name="tf_to_fix_old_map" args="0 0 0 2.51 0 0 map_toposlam map 100"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_map_to_odom" args="0 0 0 0 0 0 map odom 100"/>
</launch>