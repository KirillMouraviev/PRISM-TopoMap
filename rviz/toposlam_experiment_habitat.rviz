                  camera_color_optical_frame:
                    {}
                camera_depth_frame:
                  camera_depth_optical_frame:
                    {}
              front_left_wheel_link:
                {}
              front_right_wheel_link:
                {}
              imu_link:
                {}
              inertial_link:
                {}
              rear_left_wheel_link:
                {}
              rear_right_wheel_link:
                {}
              rslidar:
                {}
            odom:
              base_footprint:
                {}
              base_link_noised:
                base_scan_noised:
                  {}
                camera_link1_noised:
                  {}
                camera_link2_noised:
                  {}
                camera_link3_noised:
                  {}
                camera_link_noised:
                  {}
          vcur:
