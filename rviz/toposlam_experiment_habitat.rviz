        base_footprint:
          Value: true
        base_link:
          Value: true
        base_link_noised:
          Value: true
        base_scan_noised:
          Value: true
        camera_color_frame:
          Value: true
        camera_color_optical_frame:
          Value: true
        camera_depth_frame:
          Value: true
        camera_depth_optical_frame:
          Value: true
        camera_link:
          Value: true
        camera_link1_noised:
          Value: false
        camera_link2_noised:
          Value: false
        camera_link3_noised:
          Value: false
        camera_link_noised:
          Value: true
        current_state:
          Value: true
        front_left_wheel_link:
          Value: true
        front_right_wheel_link:
          Value: true
        imu_link:
          Value: true
        inertial_link:
          Value: true
        map:
          Value: true
        map_toposlam:
          Value: true
        odom:
          Value: true
        rear_left_wheel_link:
          Value: true
        rear_right_wheel_link:
          Value: true
        rslidar:
          Value: true
        vcur:
          Value: true
      Marker Alpha: 1
      Marker Scale: 5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map_toposlam:
          map:
            base_link:
              camera_link:
